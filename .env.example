# === LLM Provider Configuration ===
OPENAI_API_KEY=your-openai-api-key-here

# === Model Configuration ===
# Generator model (creates the lesson content)
GENERATOR_MODEL=gpt-4o-mini

# Evaluator model (judges lesson quality - should be >= generator capability)
EVALUATOR_MODEL=gpt-4o

# === Pipeline Configuration ===
# TOTAL attempts, counting the first one. 3 = 1 initial draft + 2 retries.
# Expressed as attempts rather than retries so the routing arithmetic cannot
# be off by one. Refinement gains concentrate in the first 1-2 iterations.
MAX_ATTEMPTS=3
